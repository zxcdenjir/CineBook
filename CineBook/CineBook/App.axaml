<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CineBook.App"
             xmlns:local="using:CineBook"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:recolor="https://irihi.tech/semi.recolor"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SemiColorPrimary" Color="#B85C38" />
                    <SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#A64F30" />
                    <SolidColorBrush x:Key="SemiColorPrimaryActive" Color="#914329" />
                    <SolidColorBrush x:Key="SemiColorPrimaryDisabled" Color="#D9B4A4" />
                    <SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#F8EAE4" />
                    <SolidColorBrush x:Key="SemiColorPrimaryLightPointerover" Color="#F0D6CA" />
                    <SolidColorBrush x:Key="SemiColorPrimaryLightActive" Color="#E5B9A7" />

                    <SolidColorBrush x:Key="SemiColorSecondary" Color="#A65335" />
                    <SolidColorBrush x:Key="SemiColorSecondaryPointerover" Color="#93462C" />
                    <SolidColorBrush x:Key="SemiColorSecondaryActive" Color="#7C3923" />
                    <SolidColorBrush x:Key="SemiColorSecondaryDisabled" Color="#D5B3A5" />
                    <SolidColorBrush x:Key="SemiColorSecondaryLight" Color="#F6E8E1" />
                    <SolidColorBrush x:Key="SemiColorSecondaryLightPointerover" Color="#EED4C8" />
                    <SolidColorBrush x:Key="SemiColorSecondaryLightActive" Color="#E2B8A7" />

                    <SolidColorBrush x:Key="MyButtonForeground" Color="#5C564C" />
                    <SolidColorBrush x:Key="SemiColorBorder" Color="#E7DFD3" />
                    <SolidColorBrush x:Key="ButtonOutlineBorderBrush" Color="#E7DFD3" />
                    <SolidColorBrush x:Key="ButtonGroupSeparatorForeground" Color="#E7DFD3" />
                    <SolidColorBrush x:Key="PageBg" Color="#FAF7F2" />

                    <SolidColorBrush x:Key="ButtonOutlineBackground" Color="#F1EBE2" />
                    <SolidColorBrush x:Key="ButtonOutlinePointeroverBackground" Color="#EAE1D4" />
                    <SolidColorBrush x:Key="ButtonOutlinePressedBackground" Color="#DED1BF" />

                    <SolidColorBrush x:Key="ToggleButtonUncheckedBackground" Color="#F1EBE2" />
                    <SolidColorBrush x:Key="ToggleButtonUncheckedBorder" Color="#E7DFD3" />

                    <SolidColorBrush x:Key="ToggleButtonCheckedBackground" Color="#F8EAE4" />
                    <SolidColorBrush x:Key="ToggleButtonCheckedForeground" Color="#914329" />
                    <SolidColorBrush x:Key="ToggleButtonCheckedBorder" Color="#B85C38" />

                    <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#B85C38" />
                    <SolidColorBrush x:Key="ButtonSolidPrimaryBorderBrush" Color="#B85C38" />

                    <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBackground" Color="#A64F30" />
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBorderBrush" Color="#A64F30" />

                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBackground" Color="#914329" />
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBorderBrush" Color="#914329" />
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedForeground" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#F1EBE2" />
                    <SolidColorBrush x:Key="TextBoxPointeroverBackground" Color="#F8F2E9" />
                    <SolidColorBrush x:Key="TextBoxPressedBackground" Color="#F0E7DA" />
                    <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#B85C38" />

                    <SolidColorBrush x:Key="CineBookAccent" Color="#B85C38" />
                    <SolidColorBrush x:Key="CineBookAccentHover" Color="#A64F30" />
                    <SolidColorBrush x:Key="CineBookAccentPressed" Color="#914329" />

                    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeartBackground" Color="#f3f2f5" />

                    <SolidColorBrush x:Key="StatusWatchedText" Color="#3E7C4F" />
                    <SolidColorBrush x:Key="StatusWatchedBackground" Color="#E4F0E4" />
                    <SolidColorBrush x:Key="StatusPlanningText" Color="#6B6459" />
                    <SolidColorBrush x:Key="StatusPlanningBackground" Color="#EFEAE1" />
                    <SolidColorBrush x:Key="StatusWatchingText" Color="#3D6B8E" />
                    <SolidColorBrush x:Key="StatusWatchingBackground" Color="#E1EBF3" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SemiColorPrimary" Color="#B85C38" />
                    <SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#A64F30" />
                    <SolidColorBrush x:Key="SemiColorPrimaryActive" Color="#914329" />
                    <SolidColorBrush x:Key="SemiColorPrimaryDisabled" Color="#795141" />
                    <SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#39271F" />
                    <SolidColorBrush x:Key="SemiColorPrimaryLightPointerover" Color="#483026" />
                    <SolidColorBrush x:Key="SemiColorPrimaryLightActive" Color="#5A382B" />

                    <SolidColorBrush x:Key="SemiColorSecondary" Color="#A65335" />
                    <SolidColorBrush x:Key="SemiColorSecondaryPointerover" Color="#93462C" />
                    <SolidColorBrush x:Key="SemiColorSecondaryActive" Color="#7C3923" />
                    <SolidColorBrush x:Key="SemiColorSecondaryDisabled" Color="#715344" />
                    <SolidColorBrush x:Key="SemiColorSecondaryLight" Color="#352821" />
                    <SolidColorBrush x:Key="SemiColorSecondaryLightPointerover" Color="#443027" />
                    <SolidColorBrush x:Key="SemiColorSecondaryLightActive" Color="#54372B" />

                    <SolidColorBrush x:Key="MyButtonForeground" Color="#C9BCAB" />
                    <SolidColorBrush x:Key="SemiColorBorder" Color="#463D33" />
                    <SolidColorBrush x:Key="ButtonOutlineBorderBrush" Color="#463D33" />
                    <SolidColorBrush x:Key="ButtonGroupSeparatorForeground" Color="#463D33" />
                    <SolidColorBrush x:Key="PageBg" Color="#201B16" />

                    <SolidColorBrush x:Key="ButtonOutlineBackground" Color="#2D261F" />
                    <SolidColorBrush x:Key="ButtonOutlinePointeroverBackground" Color="#372D23" />
                    <SolidColorBrush x:Key="ButtonOutlinePressedBackground" Color="#433629" />

                    <SolidColorBrush x:Key="ToggleButtonUncheckedBackground" Color="#2D261F" />
                    <SolidColorBrush x:Key="ToggleButtonUncheckedBorder" Color="#463D33" />

                    <SolidColorBrush x:Key="ToggleButtonCheckedBackground" Color="#39271F" />
                    <SolidColorBrush x:Key="ToggleButtonCheckedForeground" Color="#E6C2AE" />
                    <SolidColorBrush x:Key="ToggleButtonCheckedBorder" Color="#B85C38" />

                    <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#B85C38" />
                    <SolidColorBrush x:Key="ButtonSolidPrimaryBorderBrush" Color="#B85C38" />

                    <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBackground" Color="#A64F30" />
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBorderBrush" Color="#A64F30" />

                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBackground" Color="#914329" />
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBorderBrush" Color="#914329" />
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedForeground" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#29231D" />
                    <SolidColorBrush x:Key="TextBoxPointeroverBackground" Color="#30281F" />
                    <SolidColorBrush x:Key="TextBoxPressedBackground" Color="#3A2F24" />
                    <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#B85C38" />

                    <SolidColorBrush x:Key="CineBookAccent" Color="#B85C38" />
                    <SolidColorBrush x:Key="CineBookAccentHover" Color="#A64F30" />
                    <SolidColorBrush x:Key="CineBookAccentPressed" Color="#914329" />

                    <SolidColorBrush x:Key="CardBackground" Color="#2C2620" />
                    <SolidColorBrush x:Key="HeartBackground" Color="#2d2b27" />

                    <SolidColorBrush x:Key="StatusWatchedText" Color="#8CC49A" />
                    <SolidColorBrush x:Key="StatusWatchedBackground" Color="#26372B" />
                    <SolidColorBrush x:Key="StatusPlanningText" Color="#C9BDA8" />
                    <SolidColorBrush x:Key="StatusPlanningBackground" Color="#39342B" />
                    <SolidColorBrush x:Key="StatusWatchingText" Color="#8AB8D8" />
                    <SolidColorBrush x:Key="StatusWatchingBackground" Color="#243440" />

                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <ControlTheme x:Key="CineBookToggleButtonTheme"
                          TargetType="ToggleButton"
                          BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource MyButtonForeground}" />
                <Setter Property="Background" Value="{DynamicResource ToggleButtonUncheckedBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonUncheckedBorder}" />
                <Setter Property="BorderThickness" Value="1" />

                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{DynamicResource ButtonOutlinePointeroverBackground}" />
                </Style>
                <Style Selector="^:pressed">
                    <Setter Property="Background" Value="{DynamicResource ButtonOutlinePressedBackground}" />
                </Style>
                <Style Selector="^:checked">
                    <Setter Property="Background" Value="{DynamicResource ToggleButtonCheckedBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource ToggleButtonCheckedForeground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonCheckedBorder}" />
                </Style>
                <Style Selector="^:checked:pointerover">
                    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightPointerover}" />
                </Style>
                <Style Selector="^:checked:pressed">
                    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightActive}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="ru-RU" />
        <semi:SemiPopupAnimations />
        <semi:UrsaSemiTheme Locale="ru-RU" />
        <recolor:SemiThemeRecolor PrimaryColor="#B85C38" BackgroundColorLight="#FAF7F2" BackgroundColorDark="#201B16"
                                  EnableHaptic="True" HapticType="Click" />
        <materialIcons:MaterialIconStyles />

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource TextBoxDefaultBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        </Style>

        <Style Selector="TextBox:pointerover /template/ Border#PART_ContentPresenterBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        </Style>

        <Style Selector="TextBox:focus /template/ Border#PART_ContentPresenterBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxFocusBorderBrush}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Theme" Value="{StaticResource OutlineButton}" />
            <Setter Property="Foreground" Value="{DynamicResource MyButtonForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        </Style>

        <Style Selector="ToggleButton">
            <Setter Property="Theme" Value="{StaticResource CineBookToggleButtonTheme}" />
        </Style>

        <Style Selector="u|IconButton">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Theme" Value="{StaticResource OutlineIconButton}" />
            <Setter Property="Foreground" Value="{DynamicResource MyButtonForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        </Style>

        <Style Selector="u|IconButton.SurfaceButton /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource ButtonOutlineBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        </Style>

        <Style Selector="u|IconButton.SurfaceButton:pointerover /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource ButtonOutlinePointeroverBackground}" />
        </Style>

        <Style Selector="u|IconButton.SurfaceButton:pressed /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource ButtonOutlinePressedBackground}" />
        </Style>

        <Style Selector="u|IconButton.PrimaryAction /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource CineBookAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CineBookAccent}" />
        </Style>

        <Style Selector="u|IconButton.PrimaryAction:pointerover /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource CineBookAccentHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CineBookAccentHover}" />
        </Style>

        <Style Selector="u|IconButton.PrimaryAction:pressed /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource CineBookAccentPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CineBookAccentPressed}" />
        </Style>

        <Style Selector="u|ThemeToggleButton:dark /template/ u|IconButton#PART_ThemeButton:left:empty-content">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="{Binding $self.Bounds.Height}" />
        </Style>

        <Style Selector="u|ThemeToggleButton:light /template/ u|IconButton#PART_ThemeButton:left:empty-content">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="{Binding $self.Bounds.Height}" />
        </Style>

        <Style
            Selector="u|ThemeToggleButton:dark /template/ u|IconButton#PART_ThemeButton:left:empty-content /template/ Border#PART_Background">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        </Style>

        <Style
            Selector="u|ThemeToggleButton:light /template/ u|IconButton#PART_ThemeButton:left:empty-content /template/ Border#PART_Background">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        </Style>

        <Style
            Selector="u|ThemeToggleButton /template/ u|IconButton#PART_ThemeButton /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource ButtonOutlineBackground}" />
        </Style>

        <Style
            Selector="u|ThemeToggleButton /template/ u|IconButton#PART_ThemeButton:pointerover /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource ButtonOutlinePointeroverBackground}" />
        </Style>

        <Style
            Selector="u|ThemeToggleButton /template/ u|IconButton#PART_ThemeButton:pressed /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource ButtonOutlinePressedBackground}" />
        </Style>

        <Style
            Selector="u|ThemeToggleButton:dark /template/ u|IconButton#PART_ThemeButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource MyButtonForeground}" />
        </Style>

        <Style
            Selector="u|ThemeToggleButton:light /template/ u|IconButton#PART_ThemeButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource MyButtonForeground}" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize"
                    Value="{OnPlatform Default=14, Android=12, iOS=12, x:TypeArguments=x:Double}" />
        </Style>

        <Style Selector="TabItem:selected /template/ Border#PART_RootBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource CineBookAccent}" />
        </Style>

        <Style Selector="NavigationPage">
            <Setter Property="BarHeight"
                    Value="{OnPlatform Default=32, Windows=32, Linux=32, macOS=32, Android=48, iOS=48, x:TypeArguments=x:Double}" />
        </Style>

        <Style Selector="NavigationPage:nav-bar-inset /template/ Border#PART_NavigationBar">
            <Setter Property="Background" Value="{DynamicResource PageBg}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Popup">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="MenuFlyoutPresenter.CineBookMenuFlyout">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource TextBoxDefaultBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource MyButtonForeground}" />
            <Style Selector="^:selected /template/ ContentPresenter#PART_HeaderPresenter">
                <Setter Property="Foreground" Value="{DynamicResource MyButtonForeground}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_LayoutRoot:pointerover">
                <Style Selector="^ ContentPresenter#PART_HeaderPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource MyButtonForeground}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="Border.StatusPill[Tag=1]">
            <Setter Property="Background" Value="{DynamicResource StatusWatchedBackground}" />
        </Style>
        <Style Selector="Border.StatusPill[Tag=2]">
            <Setter Property="Background" Value="{DynamicResource StatusWatchingBackground}" />
        </Style>
        <Style Selector="Border.StatusPill[Tag=3]">
            <Setter Property="Background" Value="{DynamicResource StatusPlanningBackground}" />
        </Style>
        <Style Selector="Border.StatusPill[Tag=1] TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusWatchedText}" />
        </Style>
        <Style Selector="Border.StatusPill[Tag=2] TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusWatchingText}" />
        </Style>
        <Style Selector="Border.StatusPill[Tag=3] TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusPlanningText}" />
        </Style>

        <Style Selector="materialIcons|MaterialIcon">
            <Setter Property="Height" Value="20" />
        </Style>

        <Style Selector="ContentPage">
            <Setter Property="HeaderTemplate">
                <DataTemplate>
                    <Grid ColumnDefinitions="46, *" ColumnSpacing="12">
                        <Image Source="/Assets/Icon.png" />
                        <TextBlock Grid.Column="1" Text="CineBook"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   FontSize="20" />
                    </Grid>
                </DataTemplate>
            </Setter>
        </Style>

        <Style Selector="NavigationPage:nav-bar-inset /template/ Border#PART_NavigationBar">
            <Setter Property="Margin"
                    Value="{OnFormFactor Default='24 8 24 0', Mobile='12 0 12 0', x:TypeArguments=Thickness}" />
            <Style Selector="^ ContentPresenter#PART_TopCommandBar">
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Style>

        <Style Selector="NavigationPage:nav-bar-inset /template/ ContentPresenter#PART_Header">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="NavigationPage:nav-bar-inset /template/ Button#PART_BackButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0 0 12 0" />
        </Style>

        <Style Selector="u|Form">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="u|FormItem">
            <Setter Property="Margin" Value="0 0 0 0"/>
        </Style>
    </Application.Styles>
</Application>
