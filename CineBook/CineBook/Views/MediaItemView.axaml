<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:CineBook.Models"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:controls="clr-namespace:CineBook.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CineBook.Views.MediaItemView"
             x:DataType="models:MediaItemViewModel">
    <Grid ColumnDefinitions="{OnFormFactor Default='2*, 3*', Mobile='*'}" ColumnSpacing="24">
        <Border Grid.Column="0" Height="360" CornerRadius="16" ClipToBounds="True"
                VerticalAlignment="{OnFormFactor Default='Top', Mobile='Stretch'}"
                IsVisible="{OnFormFactor Default='True', Mobile='False'}">
            <Grid>
                <controls:PosterImage PosterPath="{Binding MediaItem.PosterPath}" Stretch="UniformToFill"
                       IsVisible="{Binding MediaItem.HasPoster}" />
                <Border Background="{Binding MediaItem.PosterPlaceholderBrush}"
                        IsVisible="{Binding !MediaItem.HasPoster}" />
                <Path Data="{Binding MediaItem.PosterPlaceholderIcon}"
                      Width="64" Height="64" Stretch="Uniform"
                      Stroke="#EFFFFFFF" StrokeThickness="4"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsVisible="{Binding !MediaItem.HasPoster}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="{OnFormFactor Default='1', Mobile='0'}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                <Border Height="210" CornerRadius="16" ClipToBounds="True"
                        IsVisible="{OnFormFactor Default='False', Mobile='True'}">
                    <Grid>
                        <controls:PosterImage PosterPath="{Binding MediaItem.PosterPath}" Stretch="UniformToFill"
                               IsVisible="{Binding MediaItem.HasPoster}" />
                        <Border Background="{Binding MediaItem.PosterPlaceholderBrush}"
                                IsVisible="{Binding !MediaItem.HasPoster}" />
                        <Path Data="{Binding MediaItem.PosterPlaceholderIcon}"
                              Width="48" Height="48" Stretch="Uniform"
                              Stroke="#EFFFFFFF" StrokeThickness="3"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsVisible="{Binding !MediaItem.HasPoster}" />
                    </Grid>
                </Border>

                <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                        CornerRadius="16" Padding="{OnFormFactor Default='24', Mobile='18'}">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{DynamicResource ButtonOutlineBackground}"
                                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                                    CornerRadius="999" Padding="10,5">
                                <TextBlock Text="{Binding MediaItem.Type.Name}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{DynamicResource MyButtonForeground}"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Border Tag="{Binding MediaItem.StatusId}" Classes="StatusPill"
                                    CornerRadius="999" Padding="10,5">
                                <TextBlock Text="{Binding MediaItem.Status.Name}" FontSize="12" FontWeight="Bold" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <u:Form LabelWidth="{OnFormFactor Default='120', Mobile='88'}">
                            <TextBlock Text="{Binding MediaItem.Title}" FontWeight="Bold"
                                       FontSize="{OnFormFactor Default='30', Mobile='26'}"
                                       TextWrapping="Wrap" u:FormItem.Label="Название" />
                            <TextBlock Text="{Binding MediaItem.Creator}" Classes="Tertiary"
                                       FontSize="17" TextWrapping="Wrap" u:FormItem.Label="Автор / режиссёр" />
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                        u:FormItem.Label="Оценка">
                                <u:Rating DefaultValue="{Binding MediaItem.Stars}" AllowHalf="True"
                                          IsEnabled="False" AllowClear="False" Size="18" />
                                <TextBlock Text="{Binding MediaItem.Rating}" FontSize="18"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding MediaItem.GenresStringFull}" TextWrapping="Wrap"
                                       FontSize="15" u:FormItem.Label="Жанры" />
                            <TextBlock Text="{Binding MediaItem.Description}" TextWrapping="Wrap"
                                       LineHeight="24" FontSize="15" u:FormItem.Label="Описание"
                                       IsVisible="{Binding HasDescription}" />
                        </u:Form>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentPage>
