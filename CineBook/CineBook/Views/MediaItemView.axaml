<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:CineBook.Models"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:controls="clr-namespace:CineBook.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CineBook.Views.MediaItemView"
             x:DataType="models:MediaItemViewModel">
    <Grid ColumnDefinitions="{OnFormFactor Default='2*, 3*', Mobile='*'}" ColumnSpacing="24">
        <Grid Grid.Column="0" IsVisible="{OnFormFactor Default='True', Mobile='False'}"
              x:CompileBindings="False">
            <Border MaxWidth="380" MaxHeight="560" CornerRadius="16" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    IsVisible="{Binding MediaItem.HasPoster}">
                <controls:PosterImage PosterPath="{Binding MediaItem.PosterPath}" Stretch="Uniform" />
            </Border>
            <controls:AspectRatioPanel AspectRatio="0.675676" MaxWidth="380" MaxHeight="560"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       IsVisible="{Binding !MediaItem.HasPoster}">
                <Border CornerRadius="16" ClipToBounds="True">
                    <Grid>
                        <Border Background="{Binding MediaItem.PosterPlaceholderBrush}" />
                        <Path Data="{Binding MediaItem.PosterPlaceholderIcon}"
                              Width="64" Height="64" Stretch="Uniform"
                              Stroke="#EFFFFFFF" StrokeThickness="4"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </controls:AspectRatioPanel>
        </Grid>

        <ScrollViewer Grid.Column="{OnFormFactor Default='1', Mobile='0'}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                <Grid IsVisible="{OnFormFactor Default='False', Mobile='True'}"
                      x:CompileBindings="False">
                    <Border MaxWidth="480" MaxHeight="240" CornerRadius="16" ClipToBounds="True"
                            HorizontalAlignment="Center" IsVisible="{Binding MediaItem.HasPoster}">
                        <controls:PosterImage PosterPath="{Binding MediaItem.PosterPath}" Stretch="Uniform" />
                    </Border>
                    <controls:AspectRatioPanel AspectRatio="1.6" MaxWidth="480" MaxHeight="240"
                                               HorizontalAlignment="Center"
                                               IsVisible="{Binding !MediaItem.HasPoster}">
                        <Border CornerRadius="16" ClipToBounds="True">
                            <Grid>
                                <Border Background="{Binding MediaItem.PosterPlaceholderBrush}" />
                                <Path Data="{Binding MediaItem.PosterPlaceholderIcon}"
                                      Width="48" Height="48" Stretch="Uniform"
                                      Stroke="#EFFFFFFF" StrokeThickness="3"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </controls:AspectRatioPanel>
                </Grid>

                <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                        CornerRadius="16" Padding="{OnFormFactor Default='24', Mobile='18'}">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{DynamicResource ButtonOutlineBackground}"
                                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                                    CornerRadius="999" Padding="10,5">
                                <TextBlock Text="{Binding MediaItem.Type.Name}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{DynamicResource MyButtonForeground}"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Border Tag="{Binding MediaItem.StatusId}" Classes="StatusPill"
                                    CornerRadius="999" Padding="10,5">
                                <TextBlock Text="{Binding MediaItem.Status.Name}" FontSize="12" FontWeight="Bold" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <u:Form LabelWidth="{OnFormFactor Default='120', Mobile='88'}">
                            <TextBlock Text="{Binding MediaItem.Title}" FontWeight="Bold"
                                       FontSize="{OnFormFactor Default='30', Mobile='26'}"
                                       TextWrapping="Wrap" u:FormItem.Label="Название" />
                            <TextBlock Text="{Binding MediaItem.Creator}" Classes="Tertiary"
                                       FontSize="17" TextWrapping="Wrap" u:FormItem.Label="Автор / режиссёр" />
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                        u:FormItem.Label="Оценка">
                                <u:Rating DefaultValue="{Binding MediaItem.Stars}" AllowHalf="True"
                                          IsEnabled="False" AllowClear="False" Size="18" />
                                <TextBlock Text="{Binding MediaItem.Rating}" FontSize="18"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding MediaItem.GenresStringFull}" TextWrapping="Wrap"
                                       FontSize="15" u:FormItem.Label="Жанры" />
                            <TextBlock Text="{Binding MediaItem.Description}" TextWrapping="Wrap"
                                       LineHeight="24" FontSize="15" u:FormItem.Label="Описание"
                                       IsVisible="{Binding HasDescription}" />
                        </u:Form>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8" IsVisible="{Binding IsLoadingRecommendations}">
                    <TextBlock Text="Ищем похожие произведения…" Classes="Tertiary" />
                    <ProgressBar IsIndeterminate="True" Height="3" />
                </StackPanel>

                <StackPanel Spacing="12" IsVisible="{Binding HasRecommendations}">
                    <TextBlock Text="Похожие произведения" FontSize="20" FontWeight="Bold" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:OnlineMediaRecommendation">
                                    <Border Width="220" Padding="8"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource SemiColorBorder}"
                                            BorderThickness="1" CornerRadius="12">
                                        <Grid RowDefinitions="300,Auto,Auto,*,Auto" RowSpacing="8">
                                            <Border Grid.Row="0" Width="200" CornerRadius="8" ClipToBounds="True"
                                                    HorizontalAlignment="Center">
                                                <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" MaxLines="2" />
                                            <TextBlock Grid.Row="2" Text="{Binding Creator}" Classes="Tertiary"
                                                       FontSize="12" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding HasCreator}" />
                                            <Button Grid.Row="4" Content="{Binding AddButtonText}"
                                                    IsEnabled="{Binding !IsAdded}"
                                                    HorizontalAlignment="Stretch"
                                                    Click="OnRecommendationAddClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentPage>
