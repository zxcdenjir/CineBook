<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:CineBook.Controls"
             xmlns:models="clr-namespace:CineBook.Models"
             xmlns:recolor="https://irihi.tech/semi.recolor"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CineBook.Views.AddMediaView"
             x:DataType="models:AddMediaViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <u:Form HorizontalAlignment="Stretch">
            <u:SelectionList
                u:FormItem.Label="Тип"
                HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedMediaTypeId}"
                Background="{DynamicResource SemiColorBorder}" CornerRadius="12">
                <u:SelectionList.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid HorizontalAlignment="Stretch" Columns="3" />
                    </ItemsPanelTemplate>
                </u:SelectionList.ItemsPanel>

                <u:SelectionList.Indicator>
                    <Border
                        Margin="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource ButtonOutlineBackground}"
                        Theme="{DynamicResource CardBorder}"
                        Padding="16"
                        CornerRadius="10" />
                </u:SelectionList.Indicator>

                <u:SelectionListItem
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Foreground="{DynamicResource MyButtonForeground}">
                    Фильм
                </u:SelectionListItem>

                <u:SelectionListItem
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Foreground="{DynamicResource MyButtonForeground}">
                    Сериал
                </u:SelectionListItem>

                <u:SelectionListItem
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Foreground="{DynamicResource MyButtonForeground}">
                    Книга
                </u:SelectionListItem>
            </u:SelectionList>

            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     u:FormItem.Label="Название" />

            <TextBox Text="{Binding Creator, UpdateSourceTrigger=PropertyChanged}"
                     u:FormItem.Label="{Binding CreatorLabel}" />

            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     u:FormItem.Label="Описание" Classes="TextArea ClearButton" Padding="12"/>

            <ItemsControl ItemsSource="{Binding AllGenres}" u:FormItem.Label="Жанры">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton
                            CornerRadius="22"
                            BorderThickness="1"
                            Padding="12"
                            FontWeight="Medium"
                            Content="{Binding Name}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid RowDefinitions="Auto,Auto" RowSpacing="12" ColumnDefinitions="*,*" ColumnSpacing="12">
                <u:Form Grid.Column="0" Grid.Row="0" HorizontalAlignment="Stretch">
                    <u:NumericIntUpDown u:FormItem.Label="Длительность" Minimum="0"
                                        Value="{Binding Duration, UpdateSourceTrigger=PropertyChanged}"
                                        ShowButtonSpinner="False"
                                        PlaceholderText="Минуты / Серии / Страницы" />
                </u:Form>
                <u:Form Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch">
                    <u:NumericDecimalUpDown
                        u:FormItem.Label="Рейтинг"
                        Minimum="0" Maximum="10"
                        Step="0.1"
                        Value="{Binding Rating, UpdateSourceTrigger=PropertyChanged}"
                        ShowButtonSpinner="True"
                        PlaceholderText="От 0 до 10" />
                </u:Form>
                <u:Form Grid.Column="0" Grid.Row="1" HorizontalAlignment="Stretch">
                    <ComboBox ItemsSource="{Binding AllStatuses}"
                              SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              u:FormItem.Label="Статус" />
                </u:Form>
                <u:Form Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <CheckBox
                        Content="В избранное"
                        IsChecked="{Binding IsFavorite}" VerticalAlignment="Center"
                        u:FormItem.Label="" />
                </u:Form>
            </Grid>
            <recolor:ImagePicker u:FormItem.Label="Постер"
                                 Image="{Binding SelectedImage, Mode=TwoWay}"
                                 ImagePath="{Binding PosterPath, Mode=TwoWay}"
                                 CornerRadius="12" Stretch="UniformToFill" />

            <StackPanel Spacing="8" IsVisible="{Binding CanSearchCovers}">
                <TextBlock Text="{Binding CoverResultsHeader}" FontWeight="SemiBold" />
                <TextBlock Text="Выбранное изображение сохранится на устройстве вместе с медиа."
                           Classes="Tertiary" TextWrapping="Wrap" />
                <TextBlock Text="Ищем изображения…" Classes="Tertiary"
                           IsVisible="{Binding IsSearchingCovers}" />
                <TextBlock Text="Загружаем выбранное изображение…" Classes="Tertiary"
                           IsVisible="{Binding IsSelectingCover}" />
                <TextBlock Text="{Binding CoverSearchError}" Classes="Tertiary"
                           IsVisible="{Binding HasCoverSearchError}" />
                <TextBlock Text="Ничего не найдено" Classes="Tertiary"
                           IsVisible="{Binding HasNoCoverImages}" />
                <ItemsControl ItemsSource="{Binding CoverImageResults}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:MasonryPanel Columns="{OnFormFactor Default=5, Mobile=2}"
                                                    ColumnSpacing="8" RowSpacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Padding="0" CornerRadius="8" ClipToBounds="True"
                                    HorizontalContentAlignment="Stretch"
                                    ToolTip.Tip="{Binding DisplayName}"
                                    x:CompileBindings="False"
                                    Command="{Binding $parent[ItemsControl].DataContext.SelectCoverImageCommand}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                           HorizontalAlignment="Stretch" />
                                    <Border IsVisible="{Binding IsSelected}"
                                            BorderBrush="{DynamicResource CineBookAccent}"
                                            BorderThickness="3" CornerRadius="8"
                                            IsHitTestVisible="False" />
                                    <Border IsVisible="{Binding IsSelected}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="8" Width="28" Height="28" CornerRadius="14"
                                            Background="{DynamicResource CineBookAccent}"
                                            IsHitTestVisible="False">
                                        <avalonia:MaterialIcon Kind="Check" Foreground="White"
                                                               Width="18" Height="18"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Загрузить ещё 10"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding HasMoreCoverImages}"
                        IsEnabled="{Binding !IsSearchingCovers}"
                        Command="{Binding LoadMoreCoverImagesCommand}" />
                <Button Content="Найти изображения"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding !IsSearchingCovers}"
                        Command="{Binding SearchCoverImagesCommand}" />
            </StackPanel>

            <Button IsVisible="{Binding IsEditing}"
                    Command="{Binding DeleteCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource DeleteActionForeground}"
                    BorderBrush="{DynamicResource DeleteActionForeground}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <avalonia:MaterialIcon Kind="DeleteOutline" />
                    <TextBlock Text="Удалить медиа" />
                </StackPanel>
            </Button>
        </u:Form>
    </ScrollViewer>
</UserControl>
