<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:CineBook.Controls"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="clr-namespace:CineBook.ViewModels"
             xmlns:models="clr-namespace:CineBook.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CineBook.Views.HomePage"
             x:Name="HomePageRoot"
             Background="{DynamicResource PageBg}"
             x:DataType="vm:HomePageViewModel">
    <NavigationPage.TopCommandBar>
        <Panel HorizontalAlignment="Stretch">
            <Grid
                ColumnDefinitions="Auto, Auto, Auto, Auto"
                ColumnSpacing="12"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
                <u:ThemeToggleButton Grid.Column="0" Mode="Indicator"
                                     BorderBrush="{DynamicResource SemiColorBorder}"
                                     BorderThickness="1"
                                     VerticalAlignment="Stretch"
                                     IsVisible="{OnPlatform Default=True, Android=False, iOS=False}" />
                <u:IconButton Grid.Column="1" Content="Импорт" VerticalAlignment="Stretch"
                              IsVisible="{OnPlatform Default=True, Android=False, iOS=False}"
                              Command="{Binding DataContext.ImportCommand, ElementName=HomePageRoot}"
                              x:CompileBindings="False">
                    <u:IconButton.Icon>
                        <avalonia:MaterialIcon Kind="Import" />
                    </u:IconButton.Icon>
                </u:IconButton>
                <u:IconButton Grid.Column="2" Content="Экспорт" VerticalAlignment="Stretch"
                              IsVisible="{OnPlatform Default=True, Android=False, iOS=False}"
                              Command="{Binding DataContext.ExportCommand, ElementName=HomePageRoot}"
                              x:CompileBindings="False">
                    <u:IconButton.Icon>
                        <avalonia:MaterialIcon Kind="Export" />
                    </u:IconButton.Icon>
                </u:IconButton>
                <u:IconButton Grid.Column="3" Content="Добавить" VerticalAlignment="Stretch"
                              Theme="{StaticResource SolidIconButton}" Foreground="White"
                              IsVisible="{OnPlatform Default=True, Android=False, iOS=False}"
                              BorderThickness="0"
                              Command="{Binding DataContext.AddMediaCommand, ElementName=HomePageRoot}"
                              x:CompileBindings="False">
                    <u:IconButton.Icon>
                        <avalonia:MaterialIcon Kind="Plus" />
                    </u:IconButton.Icon>
                </u:IconButton>
            </Grid>

            <Grid
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="8"
                IsVisible="{OnPlatform Default=False, Android=True, iOS=True}">

                <u:ThemeToggleButton
                    Grid.Column="1"
                    Mode="Indicator"
                    Height="44"
                    VerticalAlignment="Stretch"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1" />

                <u:IconButton Grid.Column="2"
                              Classes="SurfaceButton"
                              Width="44"
                              Height="44"
                              Padding="0"
                              VerticalAlignment="Stretch"
                              ToolTip.Tip="Дополнительные действия">

                    <u:IconButton.Icon>
                        <avalonia:MaterialIcon Kind="DotsVertical" />
                    </u:IconButton.Icon>

                    <u:IconButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="CineBookMenuFlyout"
                                    ShowMode="Transient">
                            <MenuItem Header="Импорт"
                                      Command="{Binding DataContext.ImportCommand, ElementName=HomePageRoot}"
                                      x:CompileBindings="False">
                                <MenuItem.Icon>
                                    <avalonia:MaterialIcon Kind="Import" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Экспорт"
                                      Command="{Binding DataContext.ExportCommand, ElementName=HomePageRoot}"
                                      x:CompileBindings="False">
                                <MenuItem.Icon>
                                    <avalonia:MaterialIcon Kind="Export" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Добавить"
                                      Command="{Binding DataContext.AddMediaCommand, ElementName=HomePageRoot}"
                                      x:CompileBindings="False">
                                <MenuItem.Icon>
                                    <avalonia:MaterialIcon Kind="Plus" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </u:IconButton.Flyout>
                </u:IconButton>
            </Grid>
        </Panel>
    </NavigationPage.TopCommandBar>

    <ContentPage.Resources>
        <ResourceDictionary>
            <ItemsPanelTemplate x:Key="MediaItemsPanel">
                <UniformGrid ColumnSpacing="12" RowSpacing="12"
                             Columns="{OnPlatform Default=4, Android=2, iOS=2}"
                             VerticalAlignment="Top" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="MediaItemsListPanel">
                <StackPanel Spacing="12" />
            </ItemsPanelTemplate>

            <DataTemplate x:Key="MediaItemTemplate" DataType="models:MediaItem">
                <Border BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}"
                        CornerRadius="12" VerticalAlignment="Stretch" ClipToBounds="True"
                        Background="{DynamicResource CardBackground}" Cursor="Hand">
                    <Grid ColumnDefinitions="{OnFormFactor Default='84,*', Mobile='*,Auto'}"
                          RowDefinitions="{OnFormFactor Default='*', Mobile='Auto,*'}">
                        <controls:AspectRatioPanel Grid.Row="0" Grid.Column="0" AspectRatio="0.675676"
                                                   VerticalAlignment="Top">
                            <Grid>
                                <Border CornerRadius="{OnFormFactor Default='11,0,0,11', Mobile='11,11,0,0'}"
                                        ClipToBounds="True" IsVisible="{Binding HasPoster}">
                                    <controls:PosterImage PosterPath="{Binding PosterPath}" Stretch="UniformToFill" />
                                </Border>
                                <Border Background="{Binding PosterPlaceholderBrush}"
                                        CornerRadius="{OnFormFactor Default='11,0,0,11', Mobile='11,11,0,0'}"
                                        IsVisible="{Binding !HasPoster}" />
                                <Path Data="{Binding PosterPlaceholderIcon}"
                                      Width="28" Height="28" Stretch="Uniform"
                                      Stroke="#EFFFFFFF" StrokeThickness="2.5"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"
                                      IsVisible="{Binding !HasPoster}" />
                                <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Top"
                                      Margin="{OnFormFactor Default='6', Mobile='8'}"
                                      ColumnSpacing="{OnFormFactor Default='4', Mobile='8'}"
                                      IsVisible="{OnFormFactor Default='False', Mobile='True'}">
                                    <Border Tag="{Binding StatusId}" Classes="StatusPill" CornerRadius="999"
                                            Padding="9,4" VerticalAlignment="Top" HorizontalAlignment="Left"
                                            IsVisible="{OnFormFactor Default='False', Mobile='True'}">
                                        <TextBlock Text="{Binding Status.Name}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                    <Button Grid.Column="1"
                                            Height="{OnFormFactor Default='22', Mobile='28'}"
                                            Width="{OnFormFactor Default='22', Mobile='28'}"
                                            MinHeight="0" MinWidth="0"
                                            CornerRadius="{OnFormFactor Default='11', Mobile='14'}" Padding="0"
                                            Background="{DynamicResource HeartBackground}"
                                            ToolTip.Tip="Изменить"
                                            x:CompileBindings="False"
                                            Command="{Binding $parent[ItemsControl].DataContext.EditMediaCommand}"
                                            CommandParameter="{Binding}">
                                        <avalonia:MaterialIcon Kind="Pencil"
                                                               Foreground="{DynamicResource MyButtonForeground}"
                                                               Width="{OnFormFactor Default='12', Mobile='15'}" />
                                    </Button>
                                    <Button Grid.Column="2"
                                            Height="{OnFormFactor Default='22', Mobile='28'}"
                                            Width="{OnFormFactor Default='22', Mobile='28'}"
                                            MinHeight="0" MinWidth="0"
                                            CornerRadius="{OnFormFactor Default='11', Mobile='14'}" Padding="0"
                                            Background="{DynamicResource HeartBackground}"
                                            x:CompileBindings="False"
                                            Command="{Binding $parent[ItemsControl].DataContext.ToggleFavoriteCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <avalonia:MaterialIcon Kind="HeartOutline" Foreground="#9C948A"
                                                                   Width="{OnFormFactor Default='12', Mobile='15'}"
                                                                   IsVisible="{Binding !IsFavorite}" />
                                            <avalonia:MaterialIcon Kind="Heart" Foreground="#b85c38"
                                                                   Width="{OnFormFactor Default='12', Mobile='15'}"
                                                                   IsVisible="{Binding IsFavorite}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Grid>
                        </controls:AspectRatioPanel>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="10,4"
                              RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="2"
                              VerticalAlignment="Stretch"
                              IsVisible="{OnFormFactor Default='True', Mobile='False'}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                <Border Tag="{Binding StatusId}" Classes="StatusPill" CornerRadius="999"
                                        Padding="6,3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status.Name}" FontSize="10" FontWeight="Bold" />
                                </Border>
                                <Button Grid.Column="1" Height="22" Width="22" MinHeight="0" MinWidth="0"
                                        CornerRadius="11" Padding="0"
                                        Background="{DynamicResource HeartBackground}"
                                        ToolTip.Tip="Изменить"
                                        x:CompileBindings="False"
                                        Command="{Binding $parent[ItemsControl].DataContext.EditMediaCommand}"
                                        CommandParameter="{Binding}">
                                    <avalonia:MaterialIcon Kind="Pencil"
                                                           Foreground="{DynamicResource MyButtonForeground}"
                                                           Width="12" />
                                </Button>
                                <Button Grid.Column="2" Height="22" Width="22" MinHeight="0" MinWidth="0"
                                        CornerRadius="11" Padding="0"
                                        Background="{DynamicResource HeartBackground}"
                                        x:CompileBindings="False"
                                        Command="{Binding $parent[ItemsControl].DataContext.ToggleFavoriteCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <avalonia:MaterialIcon Kind="HeartOutline" Foreground="#9C948A" Width="12"
                                                               IsVisible="{Binding !IsFavorite}" />
                                        <avalonia:MaterialIcon Kind="Heart" Foreground="#b85c38" Width="12"
                                                               IsVisible="{Binding IsFavorite}" />
                                    </Grid>
                                </Button>
                            </Grid>
                            <SelectableTextBlock Grid.Row="1" FontWeight="Bold" Text="{Binding Title}"
                                                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            <SelectableTextBlock Grid.Row="2" FontWeight="Bold" Text="{Binding Creator}"
                                                 Classes="Tertiary" TextWrapping="Wrap"
                                                 TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <u:Rating DefaultValue="{Binding Stars}" AllowHalf="True"
                                          IsEnabled="False" AllowClear="False" Size="8"
                                          Margin="-2,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Rating}" Margin="4,0,0,0" FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="5" Text="{Binding GenresString}" FontSize="11"
                                       Classes="Tertiary" TextWrapping="Wrap" VerticalAlignment="Bottom"
                                       ToolTip.Tip="{Binding GenresStringFull}" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0" Margin="12"
                              RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="5"
                              IsVisible="{OnFormFactor Default='False', Mobile='True'}">
                            <SelectableTextBlock FontWeight="Bold" Text="{Binding Title}"
                                                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            <SelectableTextBlock Grid.Row="1" FontWeight="Bold" Text="{Binding Creator}"
                                                 Classes="Tertiary" TextWrapping="Wrap"
                                                 TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <u:Rating DefaultValue="{Binding Stars}" AllowHalf="True"
                                          IsEnabled="False" AllowClear="False" Size="8"
                                          Margin="-2,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Rating}" Margin="4,0,0,0" FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="4" Text="{Binding GenresString}" FontSize="10"
                                       Classes="Tertiary" TextWrapping="Wrap" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding GenresStringFull}" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="MediaItemListTemplate" DataType="models:MediaItem">
                <Border BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}"
                        CornerRadius="12" Padding="12" VerticalAlignment="Top" ClipToBounds="True"
                        Background="{DynamicResource CardBackground}" Cursor="Hand">
                    <Grid>
                        <Grid ColumnDefinitions="30,1.5*,Auto,1.5*,Auto,Auto" Height="44" ColumnSpacing="16"
                              IsVisible="{OnFormFactor Default='True', Mobile='False'}">
                            <Grid Grid.Column="0">
                                <Border CornerRadius="10" ClipToBounds="True" IsVisible="{Binding HasPoster}">
                                    <controls:PosterImage PosterPath="{Binding PosterPath}" Stretch="UniformToFill" />
                                </Border>
                                <Border Background="{Binding PosterPlaceholderBrush}" CornerRadius="10"
                                        IsVisible="{Binding !HasPoster}" />
                                <Path Data="{Binding PosterPlaceholderIcon}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Stroke="#EFFFFFFF" StrokeThickness="1.5"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"
                                      IsVisible="{Binding !HasPoster}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <SelectableTextBlock FontWeight="Bold" Text="{Binding Title}"
                                                     TextTrimming="CharacterEllipsis" />
                                <SelectableTextBlock Text="{Binding Creator}" Classes="Tertiary"
                                                     TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Spacing="4">
                                <u:Rating DefaultValue="{Binding Stars}" AllowHalf="True"
                                          IsEnabled="False" AllowClear="False" Size="10" />
                                <TextBlock Text="{Binding Rating}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding GenresStringFull}" Classes="Tertiary"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding GenresStringFull}" />
                            <Border Grid.Column="4" Tag="{Binding StatusId}" Classes="StatusPill"
                                    CornerRadius="999" VerticalAlignment="Center" Padding="9,4">
                                <TextBlock Text="{Binding Status.Name}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                                        Spacing="8">
                                <Button Height="24" Width="24" MinHeight="0" MinWidth="0"
                                        CornerRadius="12" Padding="0"
                                        Background="{DynamicResource HeartBackground}"
                                        ToolTip.Tip="Изменить"
                                        x:CompileBindings="False"
                                        Command="{Binding $parent[ItemsControl].DataContext.EditMediaCommand}"
                                        CommandParameter="{Binding}">
                                    <avalonia:MaterialIcon Kind="Pencil"
                                                           Foreground="{DynamicResource MyButtonForeground}"
                                                           Width="13" />
                                </Button>
                                <Button Height="24" Width="24" MinHeight="0" MinWidth="0"
                                        CornerRadius="12" Padding="0"
                                        Background="{DynamicResource HeartBackground}"
                                        x:CompileBindings="False"
                                        Command="{Binding $parent[ItemsControl].DataContext.ToggleFavoriteCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <avalonia:MaterialIcon Kind="HeartOutline" Foreground="#9C948A" Width="13"
                                                               IsVisible="{Binding !IsFavorite}" />
                                        <avalonia:MaterialIcon Kind="Heart" Foreground="#b85c38" Width="13"
                                                               IsVisible="{Binding IsFavorite}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="36,*,Auto,Auto" Height="36"
                              ColumnSpacing="8" IsVisible="{OnFormFactor Default='False', Mobile='True'}">
                            <Grid Grid.Column="0">
                                <Border CornerRadius="10" ClipToBounds="True" IsVisible="{Binding HasPoster}">
                                    <controls:PosterImage PosterPath="{Binding PosterPath}" Stretch="UniformToFill" />
                                </Border>
                                <Border Background="{Binding PosterPlaceholderBrush}" CornerRadius="10"
                                        IsVisible="{Binding !HasPoster}" />
                                <Path Data="{Binding PosterPlaceholderIcon}"
                                      Width="10" Height="10" Stretch="Uniform"
                                      Stroke="#EFFFFFFF" StrokeThickness="1.5"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"
                                      IsVisible="{Binding !HasPoster}" />
                            </Grid>
                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto">
                                <SelectableTextBlock FontWeight="Bold" Text="{Binding Title}"
                                                     TextTrimming="CharacterEllipsis" />
                                <SelectableTextBlock Grid.Row="1" Text="{Binding Creator}"
                                                     Classes="Tertiary" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Border Grid.Column="2" Tag="{Binding StatusId}" Classes="StatusPill"
                                    CornerRadius="999" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Padding="9,4">
                                <TextBlock Text="{Binding Status.Name}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                        Spacing="8">
                                <Button Height="24" Width="24" MinHeight="0" MinWidth="0"
                                        CornerRadius="12" Padding="0"
                                        Background="{DynamicResource HeartBackground}"
                                        ToolTip.Tip="Изменить"
                                        x:CompileBindings="False"
                                        Command="{Binding $parent[ItemsControl].DataContext.EditMediaCommand}"
                                        CommandParameter="{Binding}">
                                    <avalonia:MaterialIcon Kind="Pencil"
                                                           Foreground="{DynamicResource MyButtonForeground}"
                                                           Width="13" />
                                </Button>
                                <Button Height="24" Width="24" MinHeight="0" MinWidth="0"
                                        CornerRadius="12" Padding="0"
                                        Background="{DynamicResource HeartBackground}"
                                        x:CompileBindings="False"
                                        Command="{Binding $parent[ItemsControl].DataContext.ToggleFavoriteCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <avalonia:MaterialIcon Kind="HeartOutline" Foreground="#9C948A" Width="13"
                                                               IsVisible="{Binding !IsFavorite}" />
                                        <avalonia:MaterialIcon Kind="Heart" Foreground="#b85c38" Width="13"
                                                               IsVisible="{Binding IsFavorite}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Styles>
        <Style Selector="ContentPage">
            <Setter Property="Background" Value="{DynamicResource PageBg}" />
        </Style>
        <Style Selector="ItemsControl.MediaItems">
            <Setter Property="ItemsPanel" Value="{StaticResource MediaItemsPanel}" />
            <Setter Property="ItemTemplate" Value="{StaticResource MediaItemTemplate}" />
        </Style>
        <Style Selector="ItemsControl.MediaItems.ListView">
            <Setter Property="ItemsPanel" Value="{StaticResource MediaItemsListPanel}" />
            <Setter Property="ItemTemplate" Value="{StaticResource MediaItemListTemplate}" />
        </Style>
    </ContentPage.Styles>

    <Grid RowDefinitions="Auto, *" RowSpacing="12">
        <Grid
            ColumnDefinitions="*, Auto, Auto"
            ColumnSpacing="12">
            <TextBox PlaceholderText="Поиск" Padding="12" CornerRadius="22"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InnerLeftContent>
                    <avalonia:MaterialIcon Kind="Magnify" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <u:Badge Grid.Column="1" Header="{Binding SelectedGenreCount}"
                     VerticalAlignment="Stretch"
                     CornerPosition="BottomRight">
                <u:IconButton Content="{OnFormFactor Default='Фильтры', Mobile='{x:Null}'}"
                              HorizontalContentAlignment="Center"
                              VerticalAlignment="Stretch"
                              Width="{OnFormFactor Mobile='44', Default='NaN'}"
                              Command="{Binding OpenFiltersCommand}">
                    <u:IconButton.Icon>
                        <avalonia:MaterialIcon Kind="FilterList" Height="20" />
                    </u:IconButton.Icon>
                </u:IconButton>
            </u:Badge>

            <u:SelectionList
                HorizontalAlignment="Right" Grid.Column="2"
                SelectedIndex="{Binding SelectedLayoutIndex, Mode=TwoWay}"
                Background="{DynamicResource SemiColorBorder}" CornerRadius="12">
                <u:SelectionList.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </u:SelectionList.ItemsPanel>

                <u:SelectionList.Indicator>
                    <Border
                        Margin="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource ButtonOutlineBackground}"
                        Theme="{DynamicResource CardBorder}"
                        Padding="16"
                        CornerRadius="10" />
                </u:SelectionList.Indicator>

                <u:SelectionListItem
                    Padding="0"
                    Width="{Binding $self.Bounds.Height}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Foreground="{DynamicResource MyButtonForeground}">
                    <avalonia:MaterialIcon Kind="ViewGridOutline" Height="20" />
                </u:SelectionListItem>

                <u:SelectionListItem
                    Padding="0"
                    Width="{Binding $self.Bounds.Height}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Foreground="{DynamicResource MyButtonForeground}">
                    <avalonia:MaterialIcon Kind="Text" Height="20" />
                </u:SelectionListItem>
            </u:SelectionList>
        </Grid>

        <TabbedPage Grid.Row="1">
            <TabbedPage.PageTransition>
                <PageSlide Duration="0.150" Orientation="Horizontal" />
            </TabbedPage.PageTransition>
            <ContentPage Header="Все">
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="{OnFormFactor Default='0 12', Mobile='0', x:TypeArguments=Thickness}">
                    <ItemsControl Classes="MediaItems" Classes.ListView="{Binding IsListView}"
                                  ItemsSource="{Binding AllMediaItems}"
                                  Tapped="OnMediaItemTapped"
                                  VerticalAlignment="Top">
                    </ItemsControl>
                </ScrollViewer>
            </ContentPage>
            <ContentPage Header="Фильмы">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              Margin="{OnFormFactor Default='0 12', Mobile='0', x:TypeArguments=Thickness}">
                    <ItemsControl Classes="MediaItems" Classes.ListView="{Binding IsListView}"
                                  ItemsSource="{Binding MoviesMediaItems}" Tapped="OnMediaItemTapped"
                                  VerticalAlignment="Top" />
                </ScrollViewer>
            </ContentPage>
            <ContentPage Header="Сериалы">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              Margin="{OnFormFactor Default='0 12', Mobile='0', x:TypeArguments=Thickness}">
                    <ItemsControl Classes="MediaItems" Classes.ListView="{Binding IsListView}"
                                  ItemsSource="{Binding SeriesMediaItems}" Tapped="OnMediaItemTapped"
                                  VerticalAlignment="Top" />
                </ScrollViewer>
            </ContentPage>
            <ContentPage Header="Книги">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              Margin="{OnFormFactor Default='0 12', Mobile='0', x:TypeArguments=Thickness}">
                    <ItemsControl Classes="MediaItems" Classes.ListView="{Binding IsListView}"
                                  ItemsSource="{Binding BooksMediaItems}" Tapped="OnMediaItemTapped"
                                  VerticalAlignment="Top" />
                </ScrollViewer>
            </ContentPage>
            <ContentPage Header="Избранное">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              Margin="{OnFormFactor Default='0 12', Mobile='0', x:TypeArguments=Thickness}">
                    <ItemsControl Classes="MediaItems" Classes.ListView="{Binding IsListView}"
                                  ItemsSource="{Binding FavouriteMediaItems}"
                                  Tapped="OnMediaItemTapped"
                                  VerticalAlignment="Top" />
                </ScrollViewer>
            </ContentPage>
        </TabbedPage>
    </Grid>
</ContentPage>
