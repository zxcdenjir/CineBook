<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:CineBook.Controls"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="clr-namespace:CineBook.ViewModels"
             xmlns:models="clr-namespace:CineBook.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CineBook.Views.HomePage"
             Background="{DynamicResource PageBg}"
             x:DataType="vm:HomePageViewModel">
    <NavigationPage.TopCommandBar>
        <Panel HorizontalAlignment="Stretch">
            <Grid
                ColumnDefinitions="Auto, Auto, Auto, Auto"
                ColumnSpacing="12"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
                <u:ThemeToggleButton Grid.Column="0" Mode="Indicator"
                                     BorderBrush="{DynamicResource SemiColorBorder}"
                                     BorderThickness="1"
                                     VerticalAlignment="Stretch"
                                     IsVisible="{OnPlatform Default=True, Android=False, iOS=False}" />
                <u:IconButton Grid.Column="1" Content="Импорт" VerticalAlignment="Stretch"
                              IsVisible="{OnPlatform Default=True, Android=False, iOS=False}">
                    <u:IconButton.Icon>
                        <avalonia:MaterialIcon Kind="Import" />
                    </u:IconButton.Icon>
                </u:IconButton>
                <u:IconButton Grid.Column="2" Content="Экспорт" VerticalAlignment="Stretch"
                              IsVisible="{OnPlatform Default=True, Android=False, iOS=False}">
                    <u:IconButton.Icon>
                        <avalonia:MaterialIcon Kind="Export" />
                    </u:IconButton.Icon>
                </u:IconButton>
                <u:IconButton Grid.Column="3" Content="Добавить" VerticalAlignment="Stretch"
                              Theme="{StaticResource SolidIconButton}" Foreground="White"
                              IsVisible="{OnPlatform Default=True, Android=False, iOS=False}"
                              BorderThickness="0">
                    <u:IconButton.Icon>
                        <avalonia:MaterialIcon Kind="Plus" />
                    </u:IconButton.Icon>
                </u:IconButton>
            </Grid>

            <Grid
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="8"
                IsVisible="{OnPlatform Default=False, Android=True, iOS=True}">

                <u:ThemeToggleButton
                    Grid.Column="1"
                    Mode="Indicator"
                    Height="44"
                    VerticalAlignment="Stretch"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1" />

                <u:IconButton Grid.Column="2"
                              Classes="SurfaceButton"
                              Width="44"
                              Height="44"
                              Padding="0"
                              VerticalAlignment="Stretch"
                              ToolTip.Tip="Дополнительные действия">

                    <u:IconButton.Icon>
                        <avalonia:MaterialIcon Kind="DotsVertical" />
                    </u:IconButton.Icon>

                    <u:IconButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="CineBookMenuFlyout"
                                    ShowMode="Transient">
                            <MenuItem Header="Импорт">
                                <MenuItem.Icon>
                                    <avalonia:MaterialIcon Kind="Import" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Экспорт">
                                <MenuItem.Icon>
                                    <avalonia:MaterialIcon Kind="Export" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Добавить">
                                <MenuItem.Icon>
                                    <avalonia:MaterialIcon Kind="Plus" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </u:IconButton.Flyout>
                </u:IconButton>
            </Grid>
        </Panel>
    </NavigationPage.TopCommandBar>

    <ContentPage.Styles>
        <Style Selector="ContentPage">
            <Setter Property="Background" Value="{DynamicResource PageBg}" />
        </Style>
    </ContentPage.Styles>

    <Grid RowDefinitions="Auto, *" RowSpacing="12">
        <Grid
            ColumnDefinitions="*, Auto, Auto"
            ColumnSpacing="12">
            <TextBox PlaceholderText="Поиск" Padding="12" CornerRadius="22">
                <TextBox.InnerLeftContent>
                    <avalonia:MaterialIcon Kind="Magnify" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <u:IconButton Grid.Column="1" Content="{OnFormFactor Default='Фильтры', Mobile='{x:Null}'}"
                          HorizontalContentAlignment="Center"
                          VerticalAlignment="Stretch"
                          Width="{OnFormFactor Mobile='44', Default='NaN'}"
                          Command="{Binding OpenFiltersCommand}">
                <u:IconButton.Icon>
                    <avalonia:MaterialIcon Kind="FilterList" Height="20" />
                </u:IconButton.Icon>
            </u:IconButton>

            <u:SelectionList
                HorizontalAlignment="Right" Grid.Column="2" SelectedIndex="0"
                Background="{DynamicResource SemiColorBorder}" CornerRadius="12">
                <u:SelectionList.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </u:SelectionList.ItemsPanel>

                <u:SelectionList.Indicator>
                    <Border
                        Margin="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource ButtonOutlineBackground}"
                        Theme="{DynamicResource CardBorder}"
                        Padding="16"
                        CornerRadius="10" />
                </u:SelectionList.Indicator>

                <u:SelectionListItem
                    Padding="0"
                    Width="{Binding $self.Bounds.Height}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Foreground="{DynamicResource MyButtonForeground}">
                    <avalonia:MaterialIcon Kind="ViewGridOutline" Height="20" />
                </u:SelectionListItem>

                <u:SelectionListItem
                    Padding="0"
                    Width="{Binding $self.Bounds.Height}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Foreground="{DynamicResource MyButtonForeground}">
                    <avalonia:MaterialIcon Kind="Text" Height="20" />
                </u:SelectionListItem>
            </u:SelectionList>
        </Grid>

        <TabbedPage Grid.Row="1">
            <TabbedPage.PageTransition>
                <PageSlide Duration="0.150" Orientation="Horizontal" />
            </TabbedPage.PageTransition>
            <ContentPage Header="Все">
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="{OnFormFactor Default='0 12', Mobile='0', x:TypeArguments=Thickness}">
                    <ItemsControl ItemsSource="{Binding AllMediaItems}"
                                  VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid ColumnSpacing="12" RowSpacing="12"
                                             Columns="{OnPlatform Default=4, Android=2, iOS=2}"
                                             VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:MediaItem">
                                <Border BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}"
                                        CornerRadius="12" VerticalAlignment="Top" ClipToBounds="True"
                                        Background="{DynamicResource CardBackground}" Cursor="Hand">
                                    <Grid
                                        RowDefinitions="{OnPlatform Default='108,92', Android='108,Auto', iOS='108,Auto'}">
                                        <Grid Grid.Row="0">
                                            <Border Background="{Binding PosterPlaceholderBrush}" />
                                            <Path Data="{Binding PosterPlaceholderIcon}"
                                                  Width="28" Height="28"
                                                  Stretch="Uniform"
                                                  Stroke="#EFFFFFFF" StrokeThickness="2.5"
                                                  StrokeLineCap="Round" StrokeJoin="Round"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Opacity="0.9" />
                                            <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Top" Margin="8">
                                                <Border Tag="{Binding StatusId}"
                                                        Classes="StatusPill"
                                                        CornerRadius="999"
                                                        Padding="9,4"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Status.Name}"
                                                               FontSize="11"
                                                               FontWeight="Bold" />
                                                </Border>
                                                <Button Grid.Column="1"
                                                        Height="24" Width="24"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="Right"
                                                        MinHeight="0" MinWidth="0"
                                                        CornerRadius="12"
                                                        Padding="0"
                                                        Background="{DynamicResource HeartBackground}"
                                                        x:CompileBindings="False"
                                                        Command="{Binding $parent[ItemsControl].DataContext.ToggleFavoriteCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <avalonia:MaterialIcon Kind="HeartOutline"
                                                                               Foreground="#9C948A"
                                                                               Width="13"
                                                                               IsVisible="{Binding !IsFavorite}" />
                                                        <avalonia:MaterialIcon Kind="Heart"
                                                                               Foreground="#b85c38"
                                                                               Width="13"
                                                                               IsVisible="{Binding IsFavorite}" />
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="12"
                                              RowDefinitions="{OnPlatform Default='Auto,Auto,*', Android='Auto,Auto,Auto', iOS='Auto,Auto,Auto'}">
                                            <SelectableTextBlock FontWeight="Bold" Text="{Binding Title}"
                                                                 TextTrimming="CharacterEllipsis" />
                                            <SelectableTextBlock Grid.Row="1" FontWeight="Bold"
                                                                 Text="{Binding Creator}" Classes="Tertiary"
                                                                 TextTrimming="CharacterEllipsis" />
                                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*"
                                                  VerticalAlignment="Bottom"
                                                  IsVisible="{OnPlatform Default=True, Android=False, iOS=False}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                    <u:Rating DefaultValue="{Binding Stars}" AllowHalf="True"
                                                              IsEnabled="False" AllowClear="False" Size="8"
                                                              Margin="-2,0,0,0"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Rating}"
                                                               Margin="4,0,0,0" FontSize="11"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding GenresString}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           Classes="Tertiary" HorizontalAlignment="Right"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding GenresStringFull}" />
                                            </Grid>
                                            <controls:ResponsiveMetadataPanel Grid.Row="2"
                                                                              VerticalAlignment="Bottom"
                                                                              IsVisible="{OnPlatform Default=False, Android=True, iOS=True}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <u:Rating DefaultValue="{Binding Stars}" AllowHalf="True"
                                                              IsEnabled="False" AllowClear="False" Size="8"
                                                              Margin="-2,0,0,0"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Rating}" Margin="6,0,0,0"
                                                               FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding GenresString}"
                                                           FontSize="10" Classes="Tertiary"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           ToolTip.Tip="{Binding GenresStringFull}" />
                                            </controls:ResponsiveMetadataPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </ContentPage>
            <ContentPage Header="Фильмы"></ContentPage>
            <ContentPage Header="Сериалы"></ContentPage>
            <ContentPage Header="Книги"></ContentPage>
            <ContentPage Header="Избранное"></ContentPage>
        </TabbedPage>
    </Grid>
</ContentPage>
