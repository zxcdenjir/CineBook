<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="clr-namespace:CineBook.ViewModels"
             xmlns:models="clr-namespace:CineBook.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CineBook.Views.HomePage"
             Header="CineBook"
             Background="{DynamicResource PageBg}"
             x:DataType="vm:HomePageViewModel">
    <NavigationPage.TopCommandBar>
        <Grid
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8"
            Margin="8"
            IsVisible="{OnPlatform Default=False, Android=True, iOS=True}">

            <u:ThemeToggleButton
                Grid.Column="1"
                Mode="Indicator"
                Height="44"
                VerticalAlignment="Stretch"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1" />

            <u:IconButton Grid.Column="2"
                          Classes="SurfaceButton"
                          Width="44"
                          Height="44"
                          Padding="0"
                          VerticalAlignment="Stretch"
                          ToolTip.Tip="Дополнительные действия">

                <u:IconButton.Icon>
                    <avalonia:MaterialIcon Kind="DotsVertical" />
                </u:IconButton.Icon>

                <u:IconButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="CineBookMenuFlyout"
                                ShowMode="Transient">
                        <MenuItem Header="Импорт">
                            <MenuItem.Icon>
                                <avalonia:MaterialIcon Kind="Import" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Экспорт">
                            <MenuItem.Icon>
                                <avalonia:MaterialIcon Kind="Export" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Добавить">
                            <MenuItem.Icon>
                                <avalonia:MaterialIcon Kind="Plus" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </u:IconButton.Flyout>
            </u:IconButton>
        </Grid>
    </NavigationPage.TopCommandBar>

    <ContentPage.Styles>
        <Style Selector="ContentPage">
            <Setter Property="Background" Value="{DynamicResource PageBg}" />
        </Style>
    </ContentPage.Styles>

    <Grid RowDefinitions="Auto, *">
        <Grid
            Margin="25"
            ColumnDefinitions="{OnPlatform Default='*, Auto, Auto, Auto', Android='*', iOS='*'}"
            ColumnSpacing="{OnPlatform Windows='12', Linux='12', macOS='12', Android='0', iOS='0'}">
            <TextBox PlaceholderText="Поиск" Padding="12" CornerRadius="22">
                <TextBox.InnerLeftContent>
                    <avalonia:MaterialIcon Kind="Magnify" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <u:ThemeToggleButton Grid.Column="1" Mode="Indicator"
                                 BorderBrush="{DynamicResource SemiColorBorder}"
                                 BorderThickness="1"
                                 VerticalAlignment="Stretch"
                                 IsVisible="{OnPlatform Default=True, Android=False, iOS=False}" />
            <u:IconButton Grid.Column="2" Content="Импорт" VerticalAlignment="Stretch"
                          IsVisible="{OnPlatform Default=True, Android=False, iOS=False}">
                <u:IconButton.Icon>
                    <avalonia:MaterialIcon Kind="Import" />
                </u:IconButton.Icon>
            </u:IconButton>
            <u:IconButton Grid.Column="3" Content="Экспорт" VerticalAlignment="Stretch"
                          IsVisible="{OnPlatform Default=True, Android=False, iOS=False}">
                <u:IconButton.Icon>
                    <avalonia:MaterialIcon Kind="Export" />
                </u:IconButton.Icon>
            </u:IconButton>
            <u:IconButton Grid.Column="4" Content="Добавить" VerticalAlignment="Stretch"
                          Theme="{StaticResource SolidIconButton}" Foreground="White"
                          IsVisible="{OnPlatform Default=True, Android=False, iOS=False}"
                          BorderThickness="0">
                <u:IconButton.Icon>
                    <avalonia:MaterialIcon Kind="Plus" />
                </u:IconButton.Icon>
            </u:IconButton>
        </Grid>
        <TabbedPage Grid.Row="1" Margin="{OnPlatform Android=0, iOS=0, Default='25 0'}">
            <ContentPage Header="Все">
                <Grid Margin="{OnPlatform Default='0 25', Android='12 0', iOS='12 0'}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding AllMediaItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid ColumnSpacing="12" RowSpacing="12"
                                                 Columns="{OnPlatform Default=4, Android=2, iOS=2}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:MediaItem">
                                    <Border BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}"
                                            CornerRadius="12" VerticalAlignment="Top" ClipToBounds="True"
                                            Background="{DynamicResource CardBackground}" Cursor="Hand">
                                        <Grid RowDefinitions="108,92">
                                            <Panel Grid.Row="0">
                                                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Top" Margin="8">
                                                    <Label Theme="{StaticResource TagLabel}"
                                                           Content="{Binding Status.Name}" Classes="Circle Green"
                                                           FontSize="11" VerticalAlignment="Top" FontWeight="Bold" />
                                                    <Border Grid.Column="1" Height="24" Width="24" CornerRadius="12"
                                                            Padding="0"
                                                            Background="{DynamicResource HeartBackground}">
                                                        <avalonia:MaterialIcon Kind="Heart" Foreground="#b85c38"
                                                                               Width="11" />
                                                    </Border>
                                                </Grid>
                                            </Panel>
                                            <Grid Grid.Row="1" Margin="12" RowDefinitions="Auto, Auto, *">
                                                <SelectableTextBlock FontWeight="Bold" Text="{Binding Title}" 
                                                                     TextTrimming="CharacterEllipsis"/>
                                                <SelectableTextBlock Grid.Row="1" FontWeight="Bold"
                                                                     Text="{Binding Creator}" Classes="Tertiary" 
                                                                     TextTrimming="CharacterEllipsis"/>
                                                <Grid Grid.Row="2" ColumnDefinitions="*,*" VerticalAlignment="Bottom">
                                                    <StackPanel Orientation="Horizontal">
                                                        <u:Rating DefaultValue="{Binding Stars}" AllowHalf="True"
                                                                  IsEnabled="False" AllowClear="False" Size="8"
                                                                  VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Rating}"
                                                                   FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding GenresString}"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Classes="Tertiary" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </ContentPage>
            <ContentPage Header="Фильмы"></ContentPage>
            <ContentPage Header="Сериалы"></ContentPage>
            <ContentPage Header="Книги"></ContentPage>
            <ContentPage Header="Избранное"></ContentPage>
        </TabbedPage>
    </Grid>
</ContentPage>