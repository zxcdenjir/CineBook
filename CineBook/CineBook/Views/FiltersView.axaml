<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:viewModels="clr-namespace:CineBook.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:Class="CineBook.Views.FiltersView"
             x:DataType="viewModels:FiltersViewModel">
    <Design.DataContext>
        <viewModels:FiltersViewModel />
    </Design.DataContext>
    <u:Form HorizontalAlignment="Stretch">
        <ItemsControl ItemsSource="{Binding AllGenres}" u:FormItem.Label="Жанры">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ToggleButton
                        CornerRadius="22"
                        BorderThickness="1"
                        Padding="12"
                        FontWeight="Medium"
                        Content="{Binding Name}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" u:FormItem.Label="Сортировка">
            <StackPanel Spacing="12">
                <RadioButton Content="По дате добавления" GroupName="SortBy"
                             IsChecked="{Binding SortByDate, Mode=TwoWay}" />
                <RadioButton Content="По рейтингу" GroupName="SortBy"
                             IsChecked="{Binding SortByRating, Mode=TwoWay}" />
                <RadioButton Content="По алфавиту" GroupName="SortBy"
                             IsChecked="{Binding SortByTitle, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="12">
                <RadioButton Content="По возрастанию" GroupName="SortDirection"
                             IsChecked="{Binding SortAscending, Mode=TwoWay}" />
                <RadioButton Content="По убыванию" GroupName="SortDirection"
                             IsChecked="{Binding SortDescending, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
        <u:IconButton VerticalAlignment="Bottom" Content="Сбросить всё"
                      Command="{Binding ClearFiltersCommand}"
                      HorizontalAlignment="Center">
            <u:IconButton.Icon>
                <avalonia:MaterialIcon Kind="FilterVariantRemove" />
            </u:IconButton.Icon>
        </u:IconButton>
    </u:Form>
</UserControl>