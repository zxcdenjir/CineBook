<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CineBook</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationTitle>CineBook</ApplicationTitle>
    <ApplicationId>com.cinebook.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <AppIcon>AppIcon</AppIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Обязательно должно быть true для iOS -->
    <PublishTrimmed>true</PublishTrimmed>

    <!-- Это отключает линкер (вырезание кода) для всех сборок -->
    <MtouchLink>None</MtouchLink>

    <!-- Включает интерпретатор, чтобы EF Core работал через рефлексию -->
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CineBook\CineBook.csproj" />
  </ItemGroup>
</Project>
